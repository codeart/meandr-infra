#!/bin/bash
# Not an ECS host: Docker alone runs the model server, on the GPU.
systemctl disable --now ecs 2>/dev/null
command -v aws >/dev/null || dnf -y -q install awscli-2

# TEI's build for this host and GPU: ours for the T4G's ARM host, TEI's own
# for a T4 or an L4. Another GPU never completes the ready hook.
until nvidia-smi >/dev/null 2>&1; do sleep 2; done
case "$(uname -m)/$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader)" in
  aarch64/7.5) image=${mirror}:turing-arm64-${tei_version} ;;
  x86_64/7.5) image=${mirror}:turing-${tei_version} ;;
  x86_64/8.9) image=${mirror}:89-${tei_version} ;;
  *) exit 1 ;;
esac

# CDI on the T4G's ARM AMI, whose legacy hook (--gpus) segfaults under Docker;
# --gpus on the x86 ECS image, where a CDI spec doesn't resolve.
gpus="--gpus all"
if [ "$(uname -m)" = aarch64 ]; then
  nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
  nvidia-ctk runtime configure --runtime=docker --cdi.enabled
  systemctl restart docker
  gpus="--device nvidia.com/gpu=all"
fi

# The image from our mirror and the model from our bucket, both over the S3 endpoint.
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}
aws s3 sync s3://${bucket}/${model} /var/lib/tei/model --only-show-errors
echo '{"max_seq_length": ${max_tokens}}' >/var/lib/tei/model/sentence_bert_config.json
# As on the CPU node: the same input limit, one text per pass, and 32-bit,
# since TEI has no bfloat16 and Qwen3 can overflow 16-bit floats.
docker run -d --restart always --ulimit core=0 --name tei $gpus -p 8080:80 -v /var/lib/tei:/data "$image" --model-id /data/model --port 80 --max-client-batch-size 128 --dtype float32 --auto-truncate false --max-batch-tokens ${max_tokens} --max-batch-requests 1
%{ if reranker != "" ~}
# The reranker beside it, in 16-bit, which its encoder takes; a pair past its window is cut.
aws s3 sync s3://${bucket}/${reranker} /var/lib/tei/rerank --only-show-errors
docker run -d --restart always --ulimit core=0 --name tei-rerank $gpus -p 8083:80 -v /var/lib/tei:/data "$image" --model-id /data/rerank --port 80 --max-client-batch-size 128 --dtype float16
%{ endif ~}
# In service only once the models answer: until then the node it replaces keeps working.
until curl -sf http://127.0.0.1:8080/health >/dev/null%{ if reranker != "" } && curl -sf http://127.0.0.1:8083/health >/dev/null%{ endif }; do sleep 5; done

%{ if fallback != "" ~}
# Every T4G serves until it's killed (the group's hold hook). The region's last
# starts the fallback as it's told to leave, at AWS's notice or the group's own;
# another staying in service keeps it off, and one leaving too checks at its own.
cat >/usr/local/bin/leaving <<'SH'
#!/bin/bash
md() { curl -sf -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"; }
while sleep 5; do
  token=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60') || continue
  [ -n "$(md spot/instance-action)" ] || [ "$(md autoscaling/target-lifecycle-state)" = Terminated ] || continue
  id=$(md instance-id)
  for _ in $(seq 20); do
    others=$(aws autoscaling describe-auto-scaling-groups --region ${region} --auto-scaling-group-names ${group} --query "AutoScalingGroups[0].Instances[?LifecycleState=='InService' && InstanceId!='$id'] | length(@)" --output text)
    if [ "$others" = 0 ]; then
      aws autoscaling set-desired-capacity --region ${region} --auto-scaling-group-name ${fallback} --desired-capacity 1
      break
    fi
    sleep 5
  done
  exit 0
done
SH
chmod +x /usr/local/bin/leaving
cat >/etc/systemd/system/leaving.service <<'UNIT'
[Unit]
After=docker.service
[Service]
ExecStart=/usr/local/bin/leaving
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now leaving

%{ endif ~}
token=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
id=$(curl -sf -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
aws autoscaling complete-lifecycle-action --region ${region} --auto-scaling-group-name ${group} \
  --lifecycle-hook-name ready --lifecycle-action-result CONTINUE --instance-id "$id"
